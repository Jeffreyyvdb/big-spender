# ~/.config/big-spender/env  (chmod 600)
# Read by the collector on every run. Variables already set in the environment win.

# Stable slug for this machine: lowercase letters, digits and dashes (e.g. laptop, desktop).
BIG_SPENDER_DEVICE_ID=
# Your big-spender server's ingest endpoint, e.g. https://example.com/api/usage/ingest
BIG_SPENDER_INGEST_URL=
# Same value as BIG_SPENDER_INGEST_TOKEN on the server.
BIG_SPENDER_INGEST_TOKEN=
