# ~/.config/big-spender/env  (chmod 600)
# Read by the collector on every run. Variables already set in the environment win.

# Stable slug for this machine: lowercase letters, digits and dashes (e.g. laptop, desktop).
BIG_SPENDER_DEVICE_ID=
# Your big-spender server's ingest endpoint, e.g. https://example.com/api/usage/ingest
BIG_SPENDER_INGEST_URL=
# Same value as BIG_SPENDER_INGEST_TOKEN on the server.
BIG_SPENDER_INGEST_TOKEN=
# Optional, on one machine only: a Cursor user API key. The collector then reads the account's
# usage from Cursor's API and sends it as the device "cursor". Set by `big-spender install --cursor`.
# BIG_SPENDER_CURSOR_API_KEY=
# Optional: experimental sources to read too, comma-separated. Their counts match ccusage on test
# data but have not been checked against real usage yet. Available: antigravity, gemini.
# BIG_SPENDER_EXPERIMENTAL=antigravity
